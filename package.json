{
  "name": "instant-weather",
  "version": "2.0.0",
  "description": "Real-time weather app with 5-day forecast, AQI, and PWA support.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "workbox-build": "7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.9.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^0.20.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.6.0"
  }
}
