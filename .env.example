# Copy to .env and fill in your WeatherAPI.com key(s).
#
# WEATHER_API_KEY   — single key (used by the Vite dev API plugin)
# WEATHER_API_KEYS  — comma-separated pool the production proxy rotates
#                     through, auto-failing-over when one hits its quota.
#                     Set this in Cloudflare Pages → Settings → Environment
#                     variables for the deployed site.
WEATHER_API_KEY=your_weatherapi_key_here
WEATHER_API_KEYS=key_one_here,key_two_here
